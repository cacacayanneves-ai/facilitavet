# ---------------------------------------------------------------------------
# Facilita Vet — variaveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# ---------------------------------------------------------------------------

# Banco de dados (obrigatorio)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facilitavet?schema=public"
# Neon (ou outro provider com connection pooling): DIRECT_URL deve apontar para
# o endpoint SEM pooler — o motor de migrations do Prisma precisa de conexao
# direta. Em Postgres local, pode ser igual a DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/facilitavet?schema=public"

# Sessao (obrigatorio) — 32+ caracteres aleatorios.
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres"

# URL publica da aplicacao (usada nos links do WhatsApp)
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google Maps Platform (opcional — sem chave o sistema usa o provider offline)
# Chave de SERVIDOR: restrinja por API (Geocoding API, Routes API).
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=""
# Provider de mapas: "auto" | "google" | "offline"
MAPS_PROVIDER="auto"
# Teto de elementos de matriz por execucao do planejador (controle de custo)
MAPS_MATRIX_ELEMENT_BUDGET="4000"

# Chave de NAVEGADOR (opcional, apenas para tiles do mapa interativo).
# Restrinja por referenciador HTTP no console do Google. Nao use a chave de servidor aqui.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# ---------------------------------------------------------------------------
# Claude (opcional — sem chave a analise contextual e desativada graciosamente)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5"
CLAUDE_ENABLED="true"

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (opcional — sem credenciais as mensagens ficam no outbox)
# ---------------------------------------------------------------------------
WHATSAPP_PROVIDER="auto"          # "auto" | "cloud-api" | "log"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_NAME=""         # opcional: template aprovado p/ fora da janela de 24h
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
WHATSAPP_VERIFY_TOKEN=""          # verificacao do webhook
WHATSAPP_APP_SECRET=""            # validacao de assinatura X-Hub-Signature-256

# ---------------------------------------------------------------------------
# Jobs agendados
# ---------------------------------------------------------------------------
# Segredo exigido no header Authorization: Bearer <CRON_SECRET> das rotas /api/cron/*
CRON_SECRET="troque-por-um-segredo-de-cron"

# ---------------------------------------------------------------------------
# Demo
# ---------------------------------------------------------------------------
DEMO_EMAIL="demo@facilitavet.app"
DEMO_PASSWORD="facilitavet"
